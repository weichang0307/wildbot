<?xml version="1.0"?>
<robot name="wildbot">

  <!-- ================= BASE LINK ================= -->
  <!-- Body size: 310x270x110 mm -->
  <link name="car_base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- ================= SAFE BOX ================= -->
  <!-- Safe box size: 410x350x100 mm -->
  <link name="safe_box">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="7.80"/>
      <inertia ixx="0.060" ixy="0" ixz="0" iyy="0.080" iyz="0" izz="0.100"/>
    </inertial>
    <visual>
      <origin xyz="0 0.170 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.410 0.010 0.010"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.4 0.8 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.170 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.410 0.010 0.010"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0 0.170 -0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.410 0.010 0.010"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0 -0.170 -0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.410 0.010 0.010"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0.200 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.350 0.010"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="-0.200 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.350 0.010"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0.200 0 -0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.350 0.010"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="-0.200 0 -0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.350 0.010"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0.200 0.170 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.010 0.100"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0.200 -0.170 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.010 0.100"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="-0.200 0.170 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.010 0.100"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="-0.200 -0.170 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.010 0.100"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.104" rpy="0 -0.3316 0"/>
      <geometry>
        <box size="0.315 0.300 0.003"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <!-- Rear wall (plane -X edge) -->
    <visual>
      <origin xyz="-0.157 0 0.076" rpy="0 -0.3316 0"/>
      <geometry>
        <box size="0.003 0.300 0.100"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <!-- Left wall (plane +Y edge) -->
    <visual>
      <origin xyz="-0.008 0.150 0.128" rpy="0 -0.3316 0"/>
      <geometry>
        <box size="0.315 0.003 0.100"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <!-- Right wall (plane -Y edge) -->
    <visual>
      <origin xyz="-0.008 -0.150 0.128" rpy="0 -0.3316 0"/>
      <geometry>
        <box size="0.315 0.003 0.100"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.410 0.350 0.100"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.104" rpy="0 -0.3316 0"/>
      <geometry>
        <box size="0.315 0.300 0.003"/>
      </geometry>
    </collision>
    <!-- Rear wall collision -->
    <collision>
      <origin xyz="-0.157 0 0.076" rpy="0 -0.3316 0"/>
      <geometry>
        <box size="0.003 0.300 0.100"/>
      </geometry>
    </collision>
    <!-- Left wall collision -->
    <collision>
      <origin xyz="-0.008 0.150 0.128" rpy="0 -0.3316 0"/>
      <geometry>
        <box size="0.315 0.003 0.100"/>
      </geometry>
    </collision>
    <!-- Right wall collision -->
    <collision>
      <origin xyz="-0.008 -0.150 0.128" rpy="0 -0.3316 0"/>
      <geometry>
        <box size="0.315 0.003 0.100"/>
      </geometry>
    </collision>
  </link>

  <joint name="car_base_to_safe_box" type="fixed">
    <parent link="car_base"/>
    <child link="safe_box"/>
    <!-- Position: 210, 175, 100 -->
    <origin xyz="0.0 0.0 0.100" rpy="0 0 0"/>
  </joint>

  <!-- ================= WHEELS ================= -->
  <!-- Wheel radius: 50mm, thickness: 46mm -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- Front Left Wheel -->
  <link name="fl_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00036" ixy="0" ixz="0" iyy="0.00056" iyz="0" izz="0.00036"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.050"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.050"/>
      </geometry>
    </collision>
  </link>

  <joint name="safe_box_to_fl_wheel" type="continuous">
    <parent link="safe_box"/>
    <child link="fl_wheel"/>
    <!-- Position: 145, 138, -50 -->
    <origin xyz="0.145 0.138 -0.050" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Right Wheel -->
  <link name="fr_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00036" ixy="0" ixz="0" iyy="0.00056" iyz="0" izz="0.00036"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.050"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.050"/>
      </geometry>
    </collision>
  </link>

  <joint name="safe_box_to_fr_wheel" type="continuous">
    <parent link="safe_box"/>
    <child link="fr_wheel"/>
    <!-- Position: 145, -138, -50 -->
    <origin xyz="0.145 -0.138 -0.050" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Left Wheel -->
  <link name="rl_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00036" ixy="0" ixz="0" iyy="0.00056" iyz="0" izz="0.00036"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.050"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.050"/>
      </geometry>
    </collision>
  </link>

  <joint name="safe_box_to_rl_wheel" type="continuous">
    <parent link="safe_box"/>
    <child link="rl_wheel"/>
    <!-- Position: -145, 138, -50 -->
    <origin xyz="-0.145 0.138 -0.050" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Right Wheel -->
  <link name="rr_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00036" ixy="0" ixz="0" iyy="0.00056" iyz="0" izz="0.00036"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.050"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="0.050"/>
      </geometry>
    </collision>
  </link>

  <joint name="safe_box_to_rr_wheel" type="continuous">
    <parent link="safe_box"/>
    <child link="rr_wheel"/>
    <!-- Position: -145, -138, -50 -->
    <origin xyz="-0.145 -0.138 -0.050" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= SENSORS ================= -->
  <!-- Camera -->
  <link name="camera">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1.9e-5" ixy="0" ixz="0" iyy="5e-6" iyz="0" izz="1.9e-5"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="safe_box_to_camera_link" type="fixed">
    <parent link="safe_box"/>
    <child link="camera_link"/>
    <!-- Position: 105, 0, 155 -->
    <origin xyz="-0.02 0.0 0.275" rpy="0 0.28 0"/>
  </joint>

  <joint name="camera_link_to_camera" type="fixed">
    <parent link="camera_link"/>
    <child link="camera"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Lidar -->
  <link name="lidar">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="2.2e-5" ixy="0" ixz="0" iyy="2.2e-5" iyz="0" izz="5.4e-5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="safe_box_to_lidar" type="fixed">
    <parent link="safe_box"/>
    <child link="lidar"/>
    <!-- Position: 50, 0, 190 -->
    <origin xyz="-0.070 0.0 0.310" rpy="0 0 0"/>
  </joint>

  <!-- ================= ARM & GRIPPER ================= -->
  <!-- Arm Link 1 (Length: 80mm) -->
  <link name="arm1_link">
    <inertial>
      <origin xyz="0.040 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="8e-6" ixy="0" ixz="0" iyy="4.9e-5" iyz="0" izz="4.9e-5"/>
    </inertial>
    <visual>
      <origin xyz="0.040 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.080 0.03 0.03"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.040 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.080 0.03 0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="safe_box_to_arm1_joint" type="revolute">
    <parent link="safe_box"/>
    <child link="arm1_link"/>
    <!-- Position: 170, 0, 26 -->
    <origin xyz="0.170 0.0 0.029" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Arm Link 2 (Length: 65mm) -->
  <link name="arm2_link">
    <inertial>
      <origin xyz="0.0325 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="4.7e-6" ixy="0" ixz="0" iyy="2.4e-5" iyz="0" izz="2.4e-5"/>
    </inertial>
    <visual>
      <origin xyz="0.0325 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.025 0.025"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0.0325 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.025 0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="arm1_to_arm2_joint" type="revolute">
    <parent link="arm1_link"/>
    <child link="arm2_link"/>
    <!-- Position: 80, 0, 0 -->
    <origin xyz="0.080 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Finger Base -->
  <link name="finger_base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="7.3e-6" ixy="0" ixz="0" iyy="2.0e-6" iyz="0" izz="7.3e-6"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="arm2_to_finger" type="fixed">
    <parent link="arm2_link"/>
    <child link="finger_base"/>
    <!-- Position: 65, 0, 0 -->
    <origin xyz="0.065 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- IR Distance Sensor (mounted on left side of finger base) -->
  <link name="ir_side_sensor">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="5.0e-7" ixy="0" ixz="0" iyy="5.0e-7" iyz="0" izz="5.0e-7"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.012 0.006 0.006"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 0.7 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.012 0.006 0.006"/>
      </geometry>
    </collision>
  </link>

  <joint name="finger_base_to_ir_side_sensor" type="fixed">
    <parent link="finger_base"/>
    <child link="ir_side_sensor"/>
    <!-- Position: 0, +28, 0 (just outside finger_base side), facing +Y -->
    <origin xyz="0.0 0.035 0.0" rpy="0 0 -0.5"/>
  </joint>

  <!-- Finger Left (Height: 65mm) -->
  <link name="finger_left">
    <inertial>
      <origin xyz="0 0 -0.0325" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1.0e-6" ixy="0" ixz="0" iyy="1.0e-6" iyz="0" izz="1.0e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0325" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="mesh/finger_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0325" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="mesh/finger_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="finger_base_to_finger_left" type="revolute">
    <parent link="finger_base"/>
    <child link="finger_left"/>
    <!-- Position: 0, 14, 0 (Finger Dis is 28, so +/- 14) -->
    <origin xyz="0.0 0.014 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="0.7854" effort="2.0" velocity="1.0"/>
  </joint>

  <!-- Finger Right (Height: 65mm) -->
  <link name="finger_right">
    <inertial>
      <origin xyz="0 0 -0.0325" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1.0e-6" ixy="0" ixz="0" iyy="1.0e-6" iyz="0" izz="1.0e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0325" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="mesh/finger_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0325" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="mesh/finger_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="finger_base_to_finger_right" type="revolute">
    <parent link="finger_base"/>
    <child link="finger_right"/>
    <!-- Position: 0, -14, 0 -->
    <origin xyz="0.0 -0.014 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="0.7854" effort="2.0" velocity="1.0"/>
  </joint>

</robot>